{
  "permissions": {
    "allow": [
      "Bash(uv run wonby *)",
      "Bash(uv run pytest *)",
      "Bash(duckdb -readonly *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pytest-on-py-edit.sh",
            "timeout": 180,
            "statusMessage": "Running tests…"
          }
        ]
      }
    ]
  }
}
